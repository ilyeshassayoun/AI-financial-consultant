**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/dist
**/dev-dist
**/build
**/playwright-report
**/test-results
**/coverage
**/*.log
**/*.db
**/*.sqlite
**/*.sqlite3
**/.idea
**/.vscode
